{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true
  },
  // Core-only build consumed by scripts/verify-*.mjs and suite integrations.
  // UI entries (App, components, the i18n bridge) stay out so the program
  // never crosses the package root; `rootDir` keeps the flat lib/<module>.js
  // layout those scripts import.
  "include": [
    "src/index.ts",
    "src/authoringEngine.ts",
    "src/interactionMutations.ts",
    "src/storyTestController.ts",
    "src/storyTestMedia.ts",
    "src/authoringMutations.ts",
    "src/conversationModel.ts",
    "src/narrativeReadingPath.ts",
    "src/narrativeNameEditing.ts",
    "src/authoringDrafts.ts",
    "src/projectMutations.ts",
    "src/eventScriptModel.ts",
    "src/eventInspectorState.ts",
    "src/twineFormat.ts",
    "src/canonChanges.ts",
    "src/speakerRoles.ts",
    "src/worldnotionVariants.ts",
    "src/canvas/nodePlacement.ts",
    "src/canvas/returnConnectors.ts",
    "src/canvas/boundaryAdderPlacement.ts",
    "src/canvas/interactionPerformance.ts",
    "src/canvas/presentationCache.ts",
    "src/inspectorDocumentIndex.ts",
    "src/inspectorFlow.ts",
    "src/narrativeValidation.ts",
    "src/explorerEntities.ts",
    "src/explorerSchema.ts",
    "src/evpathFormat.ts",
    "src/adaptiveWorkspace.ts",
    "src/universeSwitchGuard.ts",
    "src/inspectorNavigation.ts",
    "src/inspectorModules.ts",
    "src/diagnosticPresentation.ts"
  ]
}
